{
    "name": "cleverage/ui-process-bundle",
    "description": "UI for cleverage/process-bundle",
    "keywords": [
        "process",
        "task",
        "etl",
        "transformation",
        "import",
        "export",
        "ui"
    ],
    "homepage": "https://github.com/cleverage/ui-process-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Joubert",
            "email": "njoubert@clever-age.com",
            "homepage": "https://github.com/njoubert-cleverage",
            "role": "Maintainer"
        },
        {
            "name": "Xavier Marchegay",
            "email": "xmarchegay@clever-age.com",
            "homepage": "https://github.com/xaviermarchegay",
            "role": "Maintainer"
        },
        {
            "name": "Grégory Tonon",
            "email": "gtonon@clever-age.com",
            "homepage": "https://github.com/clever-age-gtonon",
            "role": "Maintainer"
        }
    ],
    "autoload": {
        "psr-4": {
            "CleverAge\\UiProcessBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleverAge\\UiProcessBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "cleverage/process-bundle": "^5.4",
        "doctrine/collections": "^1.5|^2.1|^3.1",
        "doctrine/dbal": "^3.10|^4.4",
        "doctrine/doctrine-bundle": "^2.18|^3.1",
        "doctrine/doctrine-migrations-bundle": "^3.7|^4",
        "doctrine/migrations": "^3.2",
        "doctrine/orm": "^2.20|^3.5",
        "doctrine/persistence": "^3.1|^4",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "^5",
        "monolog/monolog": "^3",
        "psr/log": "^2|^3",
        "symfony/asset": "^6.4|^7.4|^8",
        "symfony/config": "^6.4|^7.4|^8",
        "symfony/console": "^6.4|^7.4|^8",
        "symfony/dependency-injection": "^6.4|^7.4|^8",
        "symfony/deprecation-contracts": "^2.5|^3",
        "symfony/doctrine-messenger": "^6.4|^7.4|^8",
        "symfony/event-dispatcher": "^6.4|^7.4|^8",
        "symfony/event-dispatcher-contracts": "^3",
        "symfony/expression-language": "^6.4|^7.4|^8",
        "symfony/filesystem": "^6.4|^7.4|^8",
        "symfony/finder": "^6.4|^7.4|^8",
        "symfony/form": "^6.4|^7.4|^8",
        "symfony/framework-bundle": "^6.4|^7.4|^8",
        "symfony/http-foundation": "^6.4|^7.4|^8",
        "symfony/http-kernel": "^6.4|^7.4|^8",
        "symfony/messenger": "^6.4|^7.4|^8",
        "symfony/monolog-bundle": "^3.11|^4",
        "symfony/options-resolver": "^6.4|^7.4|^8",
        "symfony/password-hasher": "^6.4|^7.4|^8",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-php84": "^1.33",
        "symfony/polyfill-php85": "^1.33",
        "symfony/process": "^6.4|^7.4|^8",
        "symfony/routing": "^6.4|^7.4|^8",
        "symfony/scheduler": "^6.4.44|^7.4.17|^8.1.5",
        "symfony/security-bundle": "^6.4|^7.4|^8",
        "symfony/security-core": "^6.4|^7.4|^8",
        "symfony/security-http": "^6.4|^7.4|^8",
        "symfony/serializer": "^6.4|^7.4|^8",
        "symfony/string": "^6.4|^7.4|^8",
        "symfony/translation": "^6.4|^7.4|^8",
        "symfony/translation-contracts": "^3",
        "symfony/twig-bundle": "^6.4|^7.4|^8",
        "symfony/uid": "^6.4|^7.4|^8",
        "symfony/ux-twig-component": "^2.32|^3.0",
        "symfony/validator": "^6.4|^7.4|^8",
        "twig/twig": "^3.23"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3|^4",
        "friendsofphp/php-cs-fixer": "*",
        "masterminds/html5": "^2.7.5",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-doctrine": "*",
        "phpstan/phpstan-symfony": "*",
        "phpunit/phpunit": "^11.5.50|^12|^13",
        "rector/rector": "*",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^6.4|^7.4|^8",
        "symfony/css-selector": "^6.4|^7.4|^8",
        "symfony/debug-bundle": "^6.4|^7.4|^8",
        "symfony/maker-bundle": "^1.31",
        "symfony/notifier": "^6.4|^7.4|^8",
        "symfony/property-access": "^6.4|^7.4|^8",
        "symfony/web-profiler-bundle": "^6.4|^7.4|^8",
        "twig/extra-bundle": "^3.23",
        "vincentlanglet/twig-cs-fixer": "^3.11"
    },
    "suggest": {
        "symfony/notifier": "To notify the end of the process executions"
    },
    "conflict": {
        "symfony/twig-bridge": "7.2.0",
        "twig/twig": "v3.15.0|v3.16.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
