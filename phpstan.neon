parameters:
    level: 10
    paths:
        - src
        - tests
    ignoreErrors:
        # ProcessEvent::isProcessStopped() is only provided by the process bundle version following 5.4 (#220): remove
        # these entries once this version is required
        -
            identifier: function.alreadyNarrowedType
            paths:
                - src/EventSubscriber/ProcessEventSubscriber.php
                - tests/EventSubscriber/ProcessEventSubscriberTest.php
            reportUnmatched: false
        -
            identifier: function.impossibleType
            paths:
                - src/EventSubscriber/ProcessEventSubscriber.php
                - tests/EventSubscriber/ProcessEventSubscriberTest.php
            reportUnmatched: false
        -
            identifier: arguments.count
            path: tests/EventSubscriber/ProcessEventSubscriberTest.php
            reportUnmatched: false
